; Engine configuration file.
; Pigeon Bakery Tycoon -- an arcade idle tycoon: bake bread, sell it to pigeons.
; Everything 3D is built in code; art comes from tools/gen_art.py, sound from tools/gen_audio.py.

config_version=5

[application]

config/name="Pigeon Bakery Tycoon"
config/description="Run a bakery whose only customers are pigeons."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://icon.png"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.54, 0.82, 0.96, 1)

[autoload]

Game="*res://scripts/autoload/game.gd"
Sfx="*res://scripts/autoload/sfx.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1
window/handheld/orientation=4

[input_devices]

pointing/emulate_mouse_from_touch=true

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/size.web=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.web=1
environment/defaults/default_clear_color=Color(0.54, 0.82, 0.96, 1)
textures/vram_compression/import_etc2_astc=true
